export global Theme {
    out property <color> bg: #090d10;
    out property <color> sidebar: #0d1216;
    out property <color> surface: #12191e;
    out property <color> surface-hover: #182229;
    out property <color> surface-raised: #1c272e;
    out property <color> border: #27343b;
    out property <color> border-bright: #3b505a;
    out property <color> primary: #28b7c4;
    out property <color> primary-bright: #54d7e2;
    out property <color> primary-soft: #28b7c426;
    out property <color> accent: #d77b42;
    out property <color> accent-soft: #d77b4226;
    out property <color> success: #54b77a;
    out property <color> success-soft: #54b77a24;
    out property <color> text: #f1f6f8;
    out property <color> text-soft: #a7b5bb;
    out property <color> text-muted: #68777e;
    out property <color> danger: #ef7373;
    out property <color> danger-soft: #ef737321;
    out property <length> control-height: 28px;
    out property <length> control-radius: 5px;
    out property <length> card-radius: 10px;
}

export global Icons {
    out property <image> capture: @image-url("../assets/icons/camera.svg");
    out property <image> crop: @image-url("../assets/icons/crop-simple.svg");
    out property <image> recording: @image-url("../assets/icons/video.svg");
    out property <image> screen: @image-url("../assets/icons/desktop.svg");
    out property <image> clipboard: @image-url("../assets/icons/clipboard.svg");
    out property <image> file: @image-url("../assets/icons/file-arrow-up.svg");
    out property <image> history: @image-url("../assets/icons/clock-rotate-left.svg");
    out property <image> settings: @image-url("../assets/icons/gear.svg");
    out property <image> open: @image-url("../assets/icons/arrow-up-right-from-square.svg");
    out property <image> copy: @image-url("../assets/icons/copy.svg");
    out property <image> folder: @image-url("../assets/icons/folder-open.svg");
    out property <image> update: @image-url("../assets/icons/cloud-arrow-down.svg");
    out property <image> success: @image-url("../assets/icons/circle-check.svg");
