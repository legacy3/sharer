export global Theme {
    out property <color> bg: #10171d;
    out property <color> sidebar: #0d141a;
    out property <color> surface: #17222b;
    out property <color> surface-hover: #20303b;
    out property <color> surface-raised: #20303b;
    out property <color> border: #2b3b47;
    out property <color> border-bright: #637b8d;
    out property <color> focus: #eaf4ff;
    out property <color> primary: #82e0bf;
    out property <color> primary-bright: #a8edd5;
    out property <color> primary-text: #10251c;
    out property <color> primary-soft: #203c38;
    out property <color> accent: #f0b76b;
    out property <color> accent-soft: #f0b76b26;
    out property <color> success: #82e0bf;
    out property <color> success-soft: #82e0bf24;
    out property <color> text: #f2f5f7;
    out property <color> text-soft: #b5c3cd;
    out property <color> text-muted: #94a6b3;
    out property <color> danger: #ff9298;
    out property <color> danger-soft: #ff929826;

    out property <length> control-height: 36px;
    out property <length> control-radius: 6px;
    out property <length> card-radius: 10px;
    out property <length> page-padding: 24px;
    out property <length> card-padding: 16px;
    out property <length> status-height: 34px;
    out property <length> settings-max: 720px;
    out property <length> content-max: 1120px;

    out property <length> font-caption: 12px;
    out property <length> font-body: 14px;
    out property <length> font-label: 13px;
    out property <length> font-title: 24px;
}

export global Icons {
    out property <image> capture: @image-url("../assets/icons/camera.svg");
    out property <image> crop: @image-url("../assets/icons/crop-simple.svg");
    out property <image> recording: @image-url("../assets/icons/video.svg");
    out property <image> screen: @image-url("../assets/icons/desktop.svg");
    out property <image> clipboard: @image-url("../assets/icons/clipboard.svg");
    out property <image> file: @image-url("../assets/icons/file-arrow-up.svg");
    out property <image> history: @image-url("../assets/icons/clock-rotate-left.svg");
    out property <image> settings: @image-url("../assets/icons/gear.svg");
    out property <image> open: @image-url("../assets/icons/arrow-up-right-from-square.svg");
    out property <image> copy: @image-url("../assets/icons/copy.svg");
    out property <image> folder: @image-url("../assets/icons/folder-open.svg");
    out property <image> update: @image-url("../assets/icons/cloud-arrow-down.svg");
    out property <image> success: @image-url("../assets/icons/circle-check.svg");
    out property <image> warning: @image-url("../assets/icons/triangle-exclamation.svg");
    out property <image> trash: @image-url("../assets/icons/trash.svg");
    out property <image> chevron-down: @image-url("../assets/icons/chevron-down.svg");
    out property <image> check: @image-url("../assets/icons/check.svg");
