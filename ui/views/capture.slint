import { Icons, Theme } from "../theme.slint";
import { AppScrollView, Badge, FlatButton, IconBox, InlineNotice, PageHeading, SectionCard, SectionHeading, TooltipContent } from "../components.slint";

component CaptureAction inherits Rectangle {
    in property <string> title;
    in property <string> shortcut;
    in property <image> icon-source;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> compact: false;
    callback clicked;

    height: root.primary ? 48px : 40px;
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.card-radius;
    border-width: action-focus.has-focus ? 2px : 1px;
    border-color: action-focus.has-focus ? Theme.focus : (root.primary && root.enabled ? Theme.primary : Theme.border);
    background: root.primary && root.enabled ? (action-touch.has-hover ? Theme.primary-bright : Theme.primary) : (action-touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface);
    forward-focus: action-focus;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    HorizontalLayout {
        padding-left: root.primary ? 18px : 12px;
        padding-right: 12px;
        spacing: root.primary ? 12px : 8px;
        cross-axis-alignment: center;

        IconBox {
            icon-source: root.icon-source;
            tint: !root.enabled ? Theme.text-muted : (root.primary ? Theme.primary-text : Theme.text-soft);
            icon-size: root.primary ? 25px : 18px;
            box-width: root.primary ? 28px : 20px;
        }
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: !root.enabled ? Theme.text-muted : (root.primary ? Theme.primary-text : Theme.text);
                font-size: root.primary ? 17px : 13px;
                font-weight: 600;
                wrap: root.compact ? word-wrap : no-wrap;
                height: self.preferred-height;
                overflow: elide;
            }
            if root.shortcut != "" && !root.compact: Text {
                text: root.shortcut;
                color: root.primary && root.enabled ? Theme.primary-text : Theme.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }

    action-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: root.enabled;
        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    action-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { action-focus.focus(); root.clicked(); }
    }

    if root.shortcut != "": Tooltip { TooltipContent { text: root.shortcut; } }
}

component ArtifactValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> link: false;

    spacing: 5px;
    vertical-stretch: 0;
    Text { text: root.label; color: Theme.text-muted; font-size: 11px; font-weight: 600; }
    Text {
        text: root.value;
        color: root.link ? Theme.primary-bright : Theme.text-soft;
        font-size: 12px;
        overflow: elide;
        Tooltip { TooltipContent { text: root.value; } }
    }
}

component ArtifactPreview inherits Rectangle {
    in property <image> preview;
    in property <int> state;

    height: root.state == 2 ? 200px : 80px;
    vertical-stretch: 0;
    border-radius: 6px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.border;
    if root.state == 2: Image {
        x: 8px; y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        source: root.preview;
        image-fit: contain;
        accessible-description: "Preview of the saved local image";
    }
    if root.state != 2: VerticalLayout {
        alignment: center;
        padding: 12px;
        spacing: 6px;
        Text {
            text: root.state == 1 ? "Loading preview…" : (root.state == 3 ? "No preview for this format" : "Preview unavailable");
            color: Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component CaptureView inherits Rectangle {
    background: transparent;

    in property <bool> busy;
    in property <bool> uploading;
    in property <float> upload-progress;
    in property <bool> recording;
    in property <bool> configured;
    in property <bool> auto-upload;
    in property <bool> save-captures: true;
    in property <bool> require-tor;
    in property <bool> settings-dirty;
    in property <string> uploader-name;
    in property <bool> capture-enabled;
    in property <string> region-hotkey;
    in property <string> recording-hotkey;
    in property <string> screen-hotkey;
    in property <string> clipboard-hotkey;
    in property <string> status-text;
    in property <string> status-detail;
    in property <string> last-link;
    in property <string> last-local-path;
    in property <string> last-delete-url;
    in property <bool> last-delete-saved;
    in property <image> artifact-preview;
    in property <int> artifact-preview-state;
    in property <string> artifact-name;
    in property <string> artifact-description;
    in property <bool> artifact-is-previous;
    in property <string> artifact-status-text;
    in property <string> artifact-status-detail;
    in property <string> artifact-action-detail;
    in property <bool> artifact-action-error;
    in property <bool> update-available;
    in property <string> update-version;

    pure callback shortcut-text(string) -> string;
    callback capture-region();
    callback record-region();
    callback capture-screen();
    callback upload-clipboard();
    callback choose-file();
    callback cancel-upload();
    callback open-link();
    callback copy-link();
    callback open-local();
    callback reveal-local();
    callback copy-file();
    callback upload-last();
    callback copy-delete();
    callback open-delete();
    callback open-update();
    callback show-settings();
    callback review-settings();
    callback show-capture-settings();
    callback show-general-settings();

    property <bool> has-artifact: root.last-link != "" || root.last-local-path != "";
    property <bool> active-job: root.busy || root.uploading || root.recording;
    property <bool> public-capture: root.auto-upload && root.configured;
    property <bool> capture-ready: root.capture-enabled && (!root.auto-upload || root.configured);
    property <string> outcome-status: root.has-artifact ? (root.artifact-status-text != "" ? root.artifact-status-text : "Saved result") : root.status-text;
    property <string> outcome-detail: root.has-artifact ? root.artifact-status-detail : root.status-detail;
    property <bool> status-is-cancelled: root.outcome-status == "Upload cancelled"
            || root.outcome-status == "Saved locally, upload cancelled";
    property <bool> status-is-error: root.outcome-status == "Upload failed"
            || root.outcome-status == "Upload timed out"
            || root.outcome-status == "Saved locally, upload failed"
            || root.outcome-status == "Saved locally, upload timed out"
            || root.outcome-status == "Capture failed"
            || root.outcome-status == "Save failed"
            || root.outcome-status == "Settings invalid"
            || root.outcome-status == "History action failed"
            || root.outcome-status == "Setup required"
            || root.outcome-status == "Settings not saved";
    property <bool> current-attempt-ended: root.status-text == "Upload cancelled"
            || root.status-text == "Upload failed"
            || root.status-text == "Upload timed out"
            || root.status-text == "Capture failed"
            || root.status-text == "Save failed"
            || root.status-text == "Settings invalid";
    property <bool> narrow: root.width < 600px;

    VerticalLayout {
        spacing: 12px;

        // Job controls stay outside the scroller: Stop and Cancel never disappear
        // when an artifact, long path or notice extends below a small window.
        if root.active-job: SectionCard {
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;
                    Text {
                        horizontal-stretch: 1;
                        text: root.recording ? "Recording your region" : (root.uploading ? "Uploading to " + root.uploader-name : root.status-text);
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    if root.recording: FlatButton {
                        text: "Stop recording";
                        danger: true;
                        min-width: 130px;
                        clicked => { root.record-region(); }
                    }
                    if root.uploading: FlatButton {
                        text: "Cancel upload";
                        min-width: 120px;
                        clicked => { root.cancel-upload(); }
                    }
                }
                if root.uploading: HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.surface-raised;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * max(0, min(1, root.upload-progress));
                            height: parent.height;
                            border-radius: 2px;
                            background: Theme.primary;
                            animate width { duration: 90ms; }
                        }
                    }
                    Text { text: round(root.upload-progress * 100) + "%"; color: Theme.text-soft; font-size: 11px; width: 38px; horizontal-alignment: right; }
                }
            }
        }

        content := AppScrollView {
            content-spacing: 18px;

            VerticalLayout {
                spacing: 6px;
                PageHeading { text: "Capture"; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;
                    Badge { text: !root.capture-ready ? "Capture needs setup" : (root.public-capture ? "Public upload" : "Local only"); tone: !root.capture-ready ? 0 : (root.public-capture ? 3 : 2); }
                    Text {
                        horizontal-stretch: 1;
                        text: !root.capture-ready ? (root.auto-upload && !root.configured ? "Upload destination unavailable" : "No capture output enabled") : (root.public-capture ? root.uploader-name : "Saved on this PC");
                        color: Theme.text-soft;
                        font-size: 12px;
                        overflow: elide;
                    }
                    FlatButton {
                        text: "Change";
                        height: 28px;
                        description: "Choose whether captures stay local or upload automatically.";
                        clicked => { root.show-capture-settings(); }
                    }
                }
                Text {
                    text: !root.capture-ready ? (root.auto-upload && !root.configured ? "Configure the uploader or turn off automatic upload." : "Choose a destination before capturing.") : (root.public-capture ? (root.save-captures ? "Captures are uploaded automatically. A local copy is kept." : "Captures are uploaded automatically. No local copy is kept.") : "Capture first. Upload only when you choose.");
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }
                if root.require-tor: Text {
                    text: "Uploads require the local proxy";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }
            }

            if root.settings-dirty: InlineNotice {
                text: "Unsaved settings";
                detail: "Save or discard your changes before starting another capture or upload.";
                action-text: "Review settings";
                action => { root.review-settings(); }
            }
            if !root.capture-ready: InlineNotice {
                text: root.auto-upload && !root.configured ? "Upload destination needs attention" : "Choose where captures go";
                detail: root.auto-upload && !root.configured ? "Choose a provider, or turn off automatic upload to save captures locally." : "Turn on local copies or configure automatic uploads to start capturing.";
                action-text: "Capture settings";
                action => { root.show-capture-settings(); }
            }

            if !root.active-job: VerticalLayout {
                spacing: 8px;
                CaptureAction {
                    title: "Capture a region";
                    shortcut: root.region-hotkey + "  ·  Select any area of your screen";
                    icon-source: Icons.crop;
                    primary: true;
                    enabled: !root.settings-dirty && root.capture-ready;
                    clicked => { root.capture-region(); }
                }
                if !root.narrow: HorizontalLayout {
                    spacing: 8px;
                    CaptureAction {
                        width: (content.content-width - 24px) / 4;
                        title: "Full screen";
                        shortcut: root.screen-hotkey;
                        icon-source: Icons.screen;
                        compact: true;
                        enabled: !root.settings-dirty && root.capture-ready;
                        clicked => { root.capture-screen(); }
                    }
                    CaptureAction {
                        width: (content.content-width - 24px) / 4;
                        title: "Record region";
                        shortcut: root.recording-hotkey;
                        icon-source: Icons.recording;
                        compact: true;
                        enabled: !root.settings-dirty && root.capture-ready;
                        clicked => { root.record-region(); }
                    }
                    CaptureAction {
                        width: (content.content-width - 24px) / 4;
                        title: "Upload clipboard";
                        shortcut: root.configured ? "Upload clipboard · " + root.clipboard-hotkey : "Choose a provider first";
                        icon-source: Icons.clipboard;
                        compact: true;
                        enabled: !root.settings-dirty && root.configured;
                        clicked => { root.upload-clipboard(); }
                    }
                    CaptureAction {
                        width: (content.content-width - 24px) / 4;
                        title: "Upload file";
                        shortcut: root.configured ? "Upload a file from this PC" : "Choose a provider first";
                        icon-source: Icons.file;
                        compact: true;
                        enabled: !root.settings-dirty && root.configured;
                        clicked => { root.choose-file(); }
                    }
                }
                if root.narrow: HorizontalLayout {
                    spacing: 8px;
                    CaptureAction {
                        width: (content.content-width - 8px) / 2;
                        title: "Full screen";
                        shortcut: root.screen-hotkey;
                        icon-source: Icons.screen;
                        enabled: !root.settings-dirty && root.capture-ready;
                        clicked => { root.capture-screen(); }
                    }
                    CaptureAction {
                        width: (content.content-width - 8px) / 2;
                        title: "Record region";
                        shortcut: root.recording-hotkey;
                        icon-source: Icons.recording;
                        enabled: !root.settings-dirty && root.capture-ready;
                        clicked => { root.record-region(); }
                    }
                }
                if root.narrow: HorizontalLayout {
                    spacing: 8px;
                    CaptureAction {
                        width: (content.content-width - 8px) / 2;
                        title: "Upload clipboard";
                        shortcut: root.configured ? root.clipboard-hotkey : "Choose a provider first";
                        icon-source: Icons.clipboard;
                        enabled: !root.settings-dirty && root.configured;
                        clicked => { root.upload-clipboard(); }
                    }
                    CaptureAction {
                        width: (content.content-width - 8px) / 2;
                        title: "Upload a file";
                        shortcut: root.configured ? "Choose from this PC" : "Choose a provider first";
                        icon-source: Icons.file;
                        enabled: !root.settings-dirty && root.configured;
                        clicked => { root.choose-file(); }
                    }
                }
                if !root.configured: HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text { text: "Want to share a public link?"; color: Theme.text-muted; font-size: 12px; horizontal-stretch: 1; }
                    FlatButton { text: "Choose provider"; clicked => { root.show-settings(); } }
                }
            }

            if root.artifact-is-previous && !root.active-job && root.current-attempt-ended: SectionCard {
                border-color: root.status-text == "Upload cancelled" ? Theme.border : Theme.danger;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    Text {
                        text: root.status-text;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    if root.status-detail != "": Text {
                        text: root.status-detail;
                        color: Theme.text-soft;
                        font-size: 12px;
                        wrap: word-wrap;
                        height: self.preferred-height;
                    }
                }
            }

            if root.has-artifact || root.status-is-error || root.status-is-cancelled: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    SectionHeading { text: root.artifact-is-previous || root.active-job ? "Previous result" : "Last result"; horizontal-stretch: 1; }
                    if root.has-artifact: Badge { text: root.last-link != "" ? "Public link ready" : "Local file"; tone: root.last-link != "" ? 1 : 2; }
                }
                SectionCard {
                    border-color: root.status-is-error ? Theme.danger : Theme.border;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;
                        cross-axis-alignment: start;

                        if !root.narrow && root.last-local-path != "": ArtifactPreview {
                            width: (content.content-width - 48px) * 0.42;
                            preview: root.artifact-preview;
                            state: root.artifact-preview-state;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 14px;
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: root.artifact-name != "" ? root.artifact-name : root.outcome-status;
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    overflow: elide;
                                    Tooltip { TooltipContent { text: root.artifact-name; } }
                                }
                                if root.artifact-description != "": Text {
                                    text: root.artifact-description;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                                if root.outcome-detail != "": Text {
                                    text: root.outcome-detail;
                                    color: root.status-is-error ? Theme.danger : Theme.text-soft;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                            }
                            if root.last-link != "": VerticalLayout {
                                spacing: 8px;
                                ArtifactValue { label: "PUBLIC LINK"; value: root.last-link; link: true; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    FlatButton { text: "Copy link"; enabled: !root.active-job; primary: true; icon-source: Icons.copy; has-icon: true; clicked => { root.copy-link(); } }
                                    FlatButton { text: "Open link"; enabled: !root.active-job; clicked => { root.open-link(); } }
                                }
                            }
                            if root.last-local-path != "": VerticalLayout {
                                spacing: 8px;
                                ArtifactValue { label: "LOCAL FILE"; value: root.last-local-path; }
                                local-actions := Rectangle {
                                    // Wrap based on the details column and intrinsic button widths.
                                    property <bool> single-row: self.width >= local-copy.preferred-width + local-open.preferred-width + local-reveal.preferred-width + 16px;
                                    height: self.single-row ? Theme.control-height : Theme.control-height * 2 + 8px;
                                    vertical-stretch: 0;
                                    local-copy := FlatButton {
                                        x: 0px;
                                        y: 0px;
                                        width: self.preferred-width;
                                        text: "Copy file"; enabled: !root.active-job; primary: root.last-link == ""; icon-source: Icons.copy; has-icon: true; clicked => { root.copy-file(); }
                                    }
                                    local-open := FlatButton {
                                        x: local-copy.width + 8px;
                                        y: 0px;
                                        width: self.preferred-width;
                                        text: "Open file"; enabled: !root.active-job; clicked => { root.open-local(); }
                                    }
                                    local-reveal := FlatButton {
                                        x: local-actions.single-row ? local-open.x + local-open.width + 8px : 0px;
                                        y: local-actions.single-row ? 0px : Theme.control-height + 8px;
                                        width: self.preferred-width;
                                        text: "Show in folder"; enabled: !root.active-job; clicked => { root.reveal-local(); }
                                    }
                                }
                                if root.last-link == "": HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    FlatButton {
                                        text: root.configured ? (root.status-is-error || root.status-is-cancelled ? "Retry upload" : "Upload saved file") : "Choose upload provider";
                                        description: root.configured ? "Upload this saved file to " + root.uploader-name + " and create a public link." : "Choose a provider before uploading this saved file.";
                                        enabled: !root.active-job && !root.settings-dirty;
                                        clicked => { if root.configured { root.upload-last(); } else { root.show-settings(); } }
                                    }
                                    if root.configured: Text { text: "to " + root.uploader-name; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            if root.artifact-action-detail != "": Text {
                                text: root.artifact-action-detail;
                                color: root.artifact-action-error ? Theme.danger : Theme.success;
                                font-size: 12px;
                                wrap: word-wrap;
                                height: self.preferred-height;
                            }
                            if root.narrow && root.last-local-path != "": ArtifactPreview {
                                height: root.artifact-preview-state == 2 ? 152px : 80px;
                                preview: root.artifact-preview;
                                state: root.artifact-preview-state;
                            }
                            if root.last-delete-url != "": VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.last-delete-saved ? "A private deletion link is saved in History." : "Copy the private deletion link now; it could not be saved in History.";
                                    color: root.last-delete-saved ? Theme.text-muted : Theme.accent;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    height: self.preferred-height;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    FlatButton { text: "Copy deletion link"; enabled: !root.active-job; clicked => { root.copy-delete(); } }
                                    FlatButton { text: "Delete online…"; enabled: !root.active-job; danger: true; clicked => { root.open-delete(); } }
                                }
                            }
                        }
                    }
                }
            }

            if !root.has-artifact && !root.status-is-error && !root.status-is-cancelled && !root.active-job: SectionCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 6px;
                    Text { text: "Your capture will appear here"; color: Theme.text-soft; font-size: 14px; font-weight: 600; }
                    Text { text: "Preview it, copy the file, or share a link. Earlier captures stay in History."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                }
            }
            if root.update-available: InlineNotice {
                text: "ShareR " + root.update-version + " is available";
                detail: "Get the latest version from the project page.";
                action-text: "View release";
                kind: 1;
                action => { root.open-update(); }
            }
        }
    }
}
