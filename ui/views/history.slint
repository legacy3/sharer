import { Icons, Theme } from "../theme.slint";
import { AppScrollView, FlatButton, IconButton, InlineNotice, PageHeading, PageSubtitle, SectionCard } from "../components.slint";
import { HistoryRow } from "../models.slint";

component TableHeading inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
}

component SortableHeading inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <int> active-column;
    in property <bool> ascending;
    callback clicked(int);
    callback activate();
    activate => { root.clicked(root.column); }

    background: heading-touch.has-hover ? Theme.surface-hover : transparent;
    border-radius: 4px;
    border-width: heading-focus.has-focus ? 1px : 0px;
    border-color: Theme.primary-bright;
    forward-focus: heading-focus;
    accessible-role: button;
    accessible-label: root.label + (root.active-column == root.column ? (root.ascending ? ", sorted ascending" : ", sorted descending") : ", not sorted");
    accessible-action-default => { root.activate(); }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label + (root.active-column == root.column ? (root.ascending ? "  ↑" : "  ↓") : "");
        color: root.active-column == root.column ? Theme.text : Theme.text-muted;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Tooltip { text: @markdown("Sort by \{root.label}. Click again to reverse the order."); }

    heading-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    heading-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            heading-focus.focus();
            root.activate();
        }
    }
}

component TableCell inherits Text {
    color: Theme.text-soft;
    font-size: 12.5px;
    vertical-alignment: center;
    overflow: elide;

    Tooltip { text: @markdown("\{root.text}"); }
}

component HistoryActions inherits HorizontalLayout {
    in property <string> action-token;
    private property <string> selected-token;
    private property <bool> action-has-local;
    private property <bool> action-has-remote;
    private property <bool> action-has-delete;
    callback prepare-menu();
    prepare-menu => {
        root.selected-token = root.action-token;
        root.action-has-local = root.has-local;
        root.action-has-remote = root.has-remote;
        root.action-has-delete = root.has-delete;
    }
    // Keep dispatch on the row owner: closing a conditional popup drops its parent.
    callback close-menus();
    close-menus => {
        open-menu.close();
        copy-menu.close();
        delete-menu.close();
        context-menu.close();
    }
    callback upload-selected();
    upload-selected => {
        root.close-menus();
        root.upload-local(root.selected-token);
    }
    callback open-deletion-selected();
    open-deletion-selected => {
        root.close-menus();
        root.open-delete-link(root.selected-token);
    }
    callback copy-deletion-selected();
    copy-deletion-selected => {
        root.close-menus();
        root.copy-delete-link(root.selected-token);
    }
    in property <bool> has-local;
    in property <bool> has-remote;
    in property <bool> has-delete;
    in property <bool> upload-enabled;
    in property <string> upload-provider;
    in property <string> file-name;
    callback open-link(string);
    callback copy-link(string);
    callback copy-delete-link(string);
    callback open-delete-link(string);
    callback open-local(string);
    callback reveal-local(string);
    callback upload-local(string);
    callback copy-file(string);
    callback copy-path(string);
    callback remove-entry(string);
    callback delete-local(string);
    callback show-context-menu();
    show-context-menu => { root.prepare-menu(); context-menu.show(); }

    width: 108px;
    height: 32px;
    vertical-stretch: 0;
    alignment: end;
    spacing: 4px;

    IconButton {
        icon-source: Icons.open;
        description: root.has-local && !root.has-remote ? "Open or upload…" : "Open…";
        context: root.file-name;
        clicked => { root.prepare-menu(); open-menu.show(); }
    }
    IconButton {
        icon-source: Icons.copy;
        description: "Copy…";
        context: root.file-name;
        clicked => { root.prepare-menu(); copy-menu.show(); }
    }
    IconButton {
        icon-source: Icons.trash;
        description: "Delete or remove…";
        context: root.file-name;
        destructive: true;
        clicked => { root.prepare-menu(); delete-menu.show(); }
    }

    open-menu := PopupWindow {
        x: root.width - 228px;
        y: root.height + 4px;
        width: 228px;
        height: (root.action-has-delete ? 146px : 112px) + (root.action-has-local && !root.action-has-remote ? 34px : 0px);

        Rectangle {
            background: Theme.surface-raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-bright;

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                FlatButton { text: "Open uploaded link"; enabled: root.action-has-remote; clicked => { open-menu.close(); root.open-link(root.selected-token); } }
                if root.action-has-delete: FlatButton { text: "Open deletion page…"; description: "May delete the uploaded copy immediately. The local file and history entry stay."; danger: true; clicked => { root.open-deletion-selected(); } }
                FlatButton { text: "Open local file"; enabled: root.action-has-local; clicked => { open-menu.close(); root.open-local(root.selected-token); } }
                FlatButton { text: "Show in folder"; enabled: root.action-has-local; clicked => { open-menu.close(); root.reveal-local(root.selected-token); } }
                if root.action-has-local && !root.action-has-remote: FlatButton {
                    text: "Upload to " + root.upload-provider;
                    description: "Upload this local file using saved settings. Also retries a failed upload; the local file stays unchanged.";
                    enabled: root.upload-enabled;
                    clicked => { root.upload-selected(); }
                }
            }
        }
    }

    copy-menu := PopupWindow {
        x: root.width - 228px;
        y: root.height + 4px;
        width: 228px;
        height: root.action-has-delete ? 146px : 112px;

        Rectangle {
            background: Theme.surface-raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-bright;

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                FlatButton { text: "Copy uploaded link"; enabled: root.action-has-remote; clicked => { copy-menu.close(); root.copy-link(root.selected-token); } }
                if root.action-has-delete: FlatButton { text: "Copy deletion link"; description: "Keep this link private: anyone with it may delete the uploaded copy."; clicked => { root.copy-deletion-selected(); } }
                FlatButton { text: "Copy local path"; enabled: root.action-has-local; clicked => { copy-menu.close(); root.copy-path(root.selected-token); } }
                FlatButton { text: "Copy local file"; enabled: root.action-has-local; clicked => { copy-menu.close(); root.copy-file(root.selected-token); } }
            }
        }
    }

    delete-menu := PopupWindow {
        x: root.width - 228px;
        y: root.height + 4px;
        width: 228px;
        height: root.action-has-delete ? 158px : 124px;

        Rectangle {
            background: Theme.surface-raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-bright;

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                if root.action-has-delete: FlatButton { text: "Open deletion page…"; description: "May delete the uploaded copy immediately. The local file and history entry stay."; danger: true; clicked => { root.open-deletion-selected(); } }
                if root.action-has-delete: FlatButton { text: "Copy deletion link"; description: "Keep this link private: anyone with it may delete the uploaded copy."; clicked => { root.copy-deletion-selected(); } }
                if !root.action-has-delete: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 5px;
                    padding-bottom: 5px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.action-has-remote ? "This host did not return a deletion link." : "This entry has no uploaded copy.";
                        color: Theme.text-muted;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                FlatButton { text: "Delete local file…"; description: "Permanently delete the file from this computer. The uploaded copy and history entry stay."; danger: true; enabled: root.action-has-local; clicked => { delete-menu.close(); root.delete-local(root.selected-token); } }
                FlatButton { text: "Remove from history only"; description: "Remove the record and its saved links. No local or uploaded files are deleted."; clicked => { delete-menu.close(); root.remove-entry(root.selected-token); } }
            }
        }
    }

    context-menu := PopupWindow {
        x: root.width - 228px;
        y: root.height + 4px;
        width: 228px;
        height: (root.action-has-delete ? 354px : 300px) + (root.action-has-local && !root.action-has-remote ? 34px : 0px);

        Rectangle {
            background: Theme.surface-raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-bright;

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                FlatButton { text: "Open uploaded link"; enabled: root.action-has-remote; clicked => { context-menu.close(); root.open-link(root.selected-token); } }
                if root.action-has-delete: FlatButton { text: "Open deletion page…"; description: "May delete the uploaded copy immediately. The local file and history entry stay."; danger: true; clicked => { root.open-deletion-selected(); } }
                FlatButton { text: "Open local file"; enabled: root.action-has-local; clicked => { context-menu.close(); root.open-local(root.selected-token); } }
                FlatButton { text: "Show in folder"; enabled: root.action-has-local; clicked => { context-menu.close(); root.reveal-local(root.selected-token); } }
                if root.action-has-local && !root.action-has-remote: FlatButton { text: "Upload to " + root.upload-provider; description: "Upload this local file using saved settings. Also retries a failed upload; the local file stays unchanged."; enabled: root.upload-enabled; clicked => { root.upload-selected(); } }
                Rectangle { height: 1px; background: Theme.border; }
                FlatButton { text: "Copy uploaded link"; enabled: root.action-has-remote; clicked => { context-menu.close(); root.copy-link(root.selected-token); } }
                if root.action-has-delete: FlatButton { text: "Copy deletion link"; description: "Keep this link private: anyone with it may delete the uploaded copy."; clicked => { root.copy-deletion-selected(); } }
                FlatButton { text: "Copy local path"; enabled: root.action-has-local; clicked => { context-menu.close(); root.copy-path(root.selected-token); } }
                FlatButton { text: "Copy local file"; enabled: root.action-has-local; clicked => { context-menu.close(); root.copy-file(root.selected-token); } }
                Rectangle { height: 1px; background: Theme.border; }
                FlatButton { text: "Delete local file…"; description: "Permanently delete the file from this computer. The uploaded copy and history entry stay."; danger: true; enabled: root.action-has-local; clicked => { context-menu.close(); root.delete-local(root.selected-token); } }
                FlatButton { text: "Remove from history only"; description: "Remove the record and its saved links. No local or uploaded files are deleted."; clicked => { context-menu.close(); root.remove-entry(root.selected-token); } }
            }
        }
    }
}

export component HistoryView inherits Rectangle {
    background: transparent;
    min-height: 0px;

    in property <[HistoryRow]> rows;
    in property <string> page-label;
    in property <bool> has-previous;
    in property <bool> has-next;
    in property <int> sort-column: 1;
    in property <bool> sort-ascending: false;
    in property <bool> upload-enabled;
    in property <string> upload-provider;
    in property <bool> settings-dirty;

    callback open-link(string);
    callback copy-link(string);
    callback copy-delete-link(string);
    callback open-delete-link(string);
    callback open-local(string);
    callback reveal-local(string);
    callback upload-local(string);
    callback copy-file(string);
    callback copy-path(string);
    callback remove-entry(string);
    callback delete-local(string);
    callback previous-page();
    callback next-page();
    callback sort-column-clicked(int);
    callback show-capture();
    callback show-settings();

    property <bool> narrow: root.width < 640px;
    // Header and rows share the same column geometry, including the scroll gutter.
    property <length> table-content-width: max(0px, root.width - 24px);
    property <length> flexible-columns-width: max(0px, root.table-content-width - 26px - 108px - (root.narrow ? 20px : 40px));
    property <length> file-column-width: root.flexible-columns-width * (root.narrow ? 0.6 : 0.38);
    property <length> date-column-width: root.flexible-columns-width * 0.24;
    property <length> size-column-width: root.flexible-columns-width * 0.12;

    VerticalLayout {
        spacing: 14px;

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                PageHeading { text: "History"; }
                PageSubtitle { text: "Local captures and uploads from this computer."; }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        if root.settings-dirty: InlineNotice {
            vertical-stretch: 0;
            text: "Unsaved settings";
            detail: "Save or discard your changes before uploading a local file.";
            action-text: "Review settings";
            action => { root.show-settings(); }
        }

        SectionCard {
            vertical-stretch: 1;
            min-height: 0px;

            VerticalLayout {
                spacing: 0px;

                if root.narrow: Rectangle {
                    height: 32px;
                    background: Theme.surface-raised;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 36px;
                        spacing: 6px;

                        TableHeading { width: 34px; text: "Sort:"; }
                        SortableHeading { horizontal-stretch: 1; label: "File"; column: 0; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                        SortableHeading { horizontal-stretch: 1; label: "Date"; column: 1; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                        SortableHeading { horizontal-stretch: 1; label: "Size"; column: 2; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                        SortableHeading { horizontal-stretch: 1; label: "Retention"; column: 3; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                    }
                }

                Rectangle {
                    height: 36px;
                    background: Theme.surface-raised;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 36px;
                        spacing: 10px;

                        if root.narrow: TableHeading { width: root.file-column-width; text: "File"; }
                        if !root.narrow: SortableHeading { width: root.file-column-width; label: "File"; column: 0; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                        if !root.narrow: SortableHeading { width: root.date-column-width; label: "Date"; column: 1; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                        if !root.narrow: SortableHeading { width: root.size-column-width; label: "Size"; column: 2; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                        if root.narrow: TableHeading { horizontal-stretch: 1; text: "Retention"; }
                        if !root.narrow: SortableHeading { horizontal-stretch: 1; label: "Retention"; column: 3; active-column: root.sort-column; ascending: root.sort-ascending; clicked(column) => { root.sort-column-clicked(column); } }
                        TableHeading { width: 108px; text: "Actions"; horizontal-alignment: center; }
                    }
                }

                if root.rows.length == 0: Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 12px;
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 8px;

                        Text { text: "No captures yet"; color: Theme.text; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: "Captures and uploads will appear here, with their links and local files."; color: Theme.text-muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                        FlatButton { text: "Capture a region"; min-width: 128px; clicked => { root.show-capture(); } }
                    }
                }

                if root.rows.length > 0: AppScrollView {
                    vertical-stretch: 1;
                    min-height: 0px;

                    VerticalLayout {
                        spacing: 0px;

                        for row[index] in root.rows: Rectangle {
                            height: max(root.narrow ? 78px : 56px, expiry-cell.preferred-height + 16px);
                            border-width: 0px;
                            background: Math.mod(index, 2) == 1 ? #ffffff05 : transparent;

                            row-menu-touch := TouchArea {
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                                        actions.show-context-menu();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                cross-axis-alignment: center;

                                VerticalLayout {
                                    width: root.file-column-width;
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: row.filename;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;

                                        Tooltip { text: @markdown("\{row.filename}"); }
                                    }
                                    Text {
                                        text: row.link != "" ? row.display-link : (row.local-path != "" ? row.display-local-path : "Local file no longer available");
                                        color: row.link != "" ? Theme.primary-bright : Theme.text-muted;
                                        font-size: 11.5px;
                                        overflow: elide;

                                        Tooltip { text: @markdown("\{parent.text}"); }
                                    }
                                    if root.narrow: Text {
                                        text: row.created;
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                    if root.narrow: Text {
                                        text: row.size;
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                if !root.narrow: TableCell { width: root.date-column-width; text: row.created; }
                                if !root.narrow: TableCell { width: root.size-column-width; text: row.size; }
                                expiry-cell := TableCell { horizontal-stretch: 1; height: self.preferred-height; text: row.expires; wrap: word-wrap; }
                                actions := HistoryActions {
                                    action-token: row.action-token;
                                    file-name: row.filename;
                                    has-local: row.local-path != "";
                                    has-remote: row.link != "";
                                    has-delete: row.delete-link != "";
                                    upload-enabled: root.upload-enabled;
                                    upload-provider: root.upload-provider;

                                    open-link(action-token) => { root.open-link(action-token); }
                                    copy-link(action-token) => { root.copy-link(action-token); }
                                    copy-delete-link(action-token) => { root.copy-delete-link(action-token); }
                                    open-delete-link(action-token) => { root.open-delete-link(action-token); }
                                    open-local(action-token) => { root.open-local(action-token); }
                                    reveal-local(action-token) => { root.reveal-local(action-token); }
                                    upload-local(action-token) => { root.upload-local(action-token); }
                                    copy-file(action-token) => { root.copy-file(action-token); }
                                    copy-path(action-token) => { root.copy-path(action-token); }
                                    remove-entry(action-token) => { root.remove-entry(action-token); }
                                    delete-local(action-token) => { root.delete-local(action-token); }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 4px; background: Theme.surface; }

                Rectangle {
                    height: 46px;
                    background: Theme.surface-raised;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        FlatButton { min-width: 88px; text: "Previous"; enabled: root.has-previous; clicked => { root.previous-page(); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: root.page-label; color: Theme.text-soft; font-size: 12.5px; vertical-alignment: center; horizontal-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        FlatButton { min-width: 88px; text: "Next"; enabled: root.has-next; clicked => { root.next-page(); } }
                    }
                }
            }
        }
    }
}
