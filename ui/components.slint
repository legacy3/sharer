import { LineEdit } from "std-widgets.slint";
import { Icons, Theme } from "theme.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.text-soft;
    width: 18px;
    height: 18px;
    image-fit: contain;
    colorize: root.tint;
    accessible-role: none;
}

export component IconBox inherits Rectangle {
    in property <image> icon-source;
    in property <color> tint: Theme.text-soft;
    in property <length> icon-size: 16px;
    in property <length> box-width: 18px;

    width: root.box-width;
    background: transparent;
    Icon {
        source: root.icon-source;
        tint: root.tint;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component PageHeading inherits Text {
    color: Theme.text;
    font-size: 21px;
    font-weight: 700;
}

export component SectionHeading inherits Text {
    color: Theme.text-muted;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

export component CaptionText inherits Text {
    color: Theme.text-muted;
    font-size: 9px;
    overflow: elide;
}

export component SectionCard inherits Rectangle {
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
}

export component ActionCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon-source;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    callback clicked;

    property <bool> hovered: touch.has-hover;
    property <string> tooltip-text: root.subtitle == "" ? root.title : root.title + "\n\n" + root.subtitle;
    min-width: 0px;
    height: 62px;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.primary-bright : (hovered && enabled ? (destructive ? Theme.accent : Theme.primary) : Theme.border);
    background: hovered && enabled ? Theme.surface-hover : Theme.surface;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.subtitle == "" ? root.title : root.title + ", " + root.subtitle;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: root.width < 115px ? 7px : 8px;
        padding-right: root.width < 115px ? 5px : 6px;
        spacing: root.width < 115px ? 5px : 6px;
        IconBox {
            icon-source: root.icon-source;
            tint: !root.enabled ? Theme.text-muted : (root.destructive ? Theme.accent : Theme.primary-bright);
            icon-size: 18px;
            box-width: 19px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text { text: root.title; color: root.enabled ? Theme.text : Theme.text-muted; font-size: 11px; font-weight: 700; overflow: elide; }
            CaptionText { text: root.subtitle; color: Theme.text-soft; font-size: 8px; }
        }
    }

    focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Tooltip { text: @markdown("\{root.tooltip-text}"); }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    property <bool> hovered: touch.has-hover;

    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: !enabled ? Theme.border : (primary ? Theme.primary : Theme.border);
    background: !enabled ? transparent : (primary ? (hovered ? Theme.primary-bright : Theme.primary) : (hovered ? Theme.surface-hover : Theme.surface-raised));
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        spacing: 6px;
        if root.has-icon: IconBox { icon-source: root.icon-source; tint: root.primary ? Theme.bg : Theme.text-soft; icon-size: 12px; box-width: 13px; }
        Text {
            horizontal-stretch: 0;
            text: root.text;
            color: !root.enabled ? Theme.text-muted : (root.primary ? Theme.bg : Theme.text);
            font-size: 10px;
            font-weight: 650;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus: Rectangle { border-radius: root.border-radius; border-width: 1px; border-color: Theme.primary-bright; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { focus.focus(); root.clicked(); } }
}

export component SelectableButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> outlined: true;
    callback clicked;
    property <bool> hovered: touch.has-hover;

    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: root.outlined || focus.has-focus ? 1px : 0px;
    border-color: focus.has-focus ? Theme.primary-bright : (root.selected ? Theme.primary : Theme.border);
    background: root.selected ? (root.outlined ? Theme.primary-soft : Theme.surface-raised) : (root.hovered ? Theme.surface-hover : (root.outlined ? Theme.surface-raised : transparent));
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    Text {
        text: root.text;
        color: root.selected ? Theme.primary-bright : Theme.text-soft;
        font-size: root.outlined ? 9px : 10px;
        font-weight: root.selected ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> description;
    in property <bool> destructive: false;
    callback clicked;
    property <bool> hovered: touch.has-hover;

    width: 28px;
    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: hovered ? (root.destructive ? Theme.danger-soft : Theme.surface-raised) : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.primary-bright;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.description;
    accessible-action-default => { root.clicked(); }
    Icon { source: root.icon-source; tint: root.destructive ? Theme.danger : (hovered ? Theme.primary-bright : Theme.text-soft); width: 13px; height: 13px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    Tooltip { text: @markdown("\{root.description}"); }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> selected: false;
    callback clicked;
    property <bool> hovered: touch.has-hover;

    height: 38px;
    vertical-stretch: 0;
    border-radius: 7px;
    background: selected ? Theme.primary-soft : (hovered ? Theme.surface-hover : transparent);
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.primary-bright;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        IconBox { icon-source: root.icon-source; tint: root.selected ? Theme.primary-bright : Theme.text-soft; icon-size: 15px; box-width: 18px; }
        Text { text: root.text; color: root.selected ? Theme.text : Theme.text-soft; font-size: 11px; font-weight: root.selected ? 700 : 550; vertical-alignment: center; }
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component FieldLabel inherits Text {
    color: Theme.text-soft;
    font-size: 10px;
    font-weight: 600;
    vertical-alignment: center;
}

export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 112px;
    in property <length> gap: 10px;

    height: 32px;
    spacing: root.gap;
    FieldLabel { width: root.label-width; text: root.label; }
    @children
}

export component CompactField inherits LineEdit {
    in property <bool> field-enabled: true;

    height: Theme.control-height;
    vertical-stretch: 0;
    opacity: root.field-enabled ? 1 : 0.55;
    enabled: root.field-enabled;
}

export component CompactSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> control-enabled: true;
    property <bool> hovered: select-touch.has-hover;

    height: Theme.control-height;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: select-focus.has-focus ? Theme.primary : Theme.border;
    background: root.hovered ? Theme.surface-hover : Theme.surface-raised;
    opacity: root.control-enabled ? 1 : 0.5;
    forward-focus: select-focus;
    accessible-role: combobox;
    accessible-enabled: root.control-enabled;
    accessible-expandable: true;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    accessible-action-expand => { if (root.control-enabled) { choices.show(); } }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
            color: Theme.text;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        IconBox { icon-source: Icons.chevron-down; tint: Theme.text-soft; icon-size: 10px; box-width: 12px; }
    }
    select-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.control-enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                choices.show();
                return accept;
            }
            return reject;
        }
    }
    select-touch := TouchArea {
        enabled: root.control-enabled;
        mouse-cursor: root.control-enabled ? pointer : default;
        clicked => { select-focus.focus(); choices.show(); }
    }
    choices := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.model.length * 28px + 8px;

        Rectangle {
            background: Theme.surface-raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-bright;
            VerticalLayout {
                padding: 4px;
                for label[index] in root.model: Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: index == root.current-index ? Theme.primary-soft : (row-touch.has-hover ? Theme.surface-hover : transparent);
                    Text {
                        text: label;
                        color: index == root.current-index ? Theme.primary-bright : Theme.text;
                        font-size: 10px;
                        font-weight: index == root.current-index ? 700 : 550;
                        vertical-alignment: center;
                        x: 7px;
                        width: parent.width - 14px;
                    }
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.current-index = index; choices.close(); }
                    }
                }
            }
        }
    }
}

export component NumberStepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step-size: 1;

    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface-raised;
    accessible-role: spinbox;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step-size;
    accessible-action-increment => { root.value = min(root.maximum, root.value + root.step-size); }
    accessible-action-decrement => { root.value = max(root.minimum, root.value - root.step-size); }

    HorizontalLayout {
        minus := Rectangle {
            width: 24px;
            background: minus-touch.has-hover && root.value > root.minimum ? Theme.surface-hover : transparent;
            Text { text: "−"; color: root.value > root.minimum ? Theme.text-soft : Theme.text-muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            minus-touch := TouchArea {
                enabled: root.value > root.minimum;
                mouse-cursor: root.value > root.minimum ? pointer : default;
                clicked => { root.value = max(root.minimum, root.value - root.step-size); }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        Text { text: "\{root.value}"; color: Theme.text; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { width: 1px; background: Theme.border; }
        plus := Rectangle {
            width: 24px;
            background: plus-touch.has-hover && root.value < root.maximum ? Theme.surface-hover : transparent;
            Text { text: "+"; color: root.value < root.maximum ? Theme.text-soft : Theme.text-muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            plus-touch := TouchArea {
                enabled: root.value < root.maximum;
                mouse-cursor: root.value < root.maximum ? pointer : default;
                clicked => { root.value = min(root.maximum, root.value + root.step-size); }
            }
        }
    }
}

export component InlineNotice inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> action-text;
    in property <int> kind: 0;
    callback action();

    property <color> notice-color: root.kind == 2 ? Theme.danger : (root.kind == 1 ? Theme.primary-bright : Theme.accent);
    property <color> notice-background: root.kind == 2 ? Theme.danger-soft : (root.kind == 1 ? Theme.primary-soft : Theme.accent-soft);
    height: root.detail == "" ? 36px : 44px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.notice-color;
    background: root.notice-background;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        IconBox { icon-source: root.kind == 1 ? Icons.update : Icons.warning; tint: root.notice-color; icon-size: 14px; box-width: 16px; }
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text { text: root.text; color: Theme.text; font-size: 10px; font-weight: 700; overflow: elide; }
            if root.detail != "": CaptionText { text: root.detail; color: Theme.text-soft; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if root.action-text != "": FlatButton { width: 92px; text: root.action-text; clicked => { root.action(); } }
    }
}
