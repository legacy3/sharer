import { LineEdit, ScrollView } from "std-widgets.slint";
import { Icons, Theme } from "theme.slint";

// Native Tooltip keeps its input-transparent hover behavior; custom content
// bounds long labels and visibly elides values too tall for a small window.
export component TooltipContent inherits Rectangle {
    in property <string> text;

    width: min(320px, max(48px, tooltip-label.preferred-width + 20px));
    height: min(240px, tooltip-label.preferred-height + 20px);
    preferred-width: root.width;
    preferred-height: root.height;
    background: Theme.surface-raised;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.border-bright;

    tooltip-label := Text {
        x: 10px;
        y: 10px;
        width: root.width - 20px;
        height: root.height - 20px;
        text: root.text;
        color: Theme.text;
        font-size: 12.5px;
        wrap: word-wrap;
        overflow: elide;
    }
}

// Fluent scrollbars overlay their viewport. Reserve space for the complete
// 14px hit target plus breathing room, even while the narrow thumb is hidden.
export component AppScrollView inherits ScrollView {
    in property <length> content-spacing: 14px;
    out property <length> content-width: root.visible-width - 24px;
    viewport-width: root.visible-width;
    horizontal-scrollbar-policy: always-off;

    VerticalLayout {
        padding-right: 24px;
        padding-bottom: 8px;
        spacing: root.content-spacing;
        alignment: start;
        @children
    }
}

export component Icon inherits Image {
    in property <color> tint: Theme.text-soft;
    in property <length> icon-size: 18px;

    width: root.icon-size;
    height: root.icon-size;
    image-fit: contain;
    colorize: root.tint;
    accessible-role: none;
}

export component IconBox inherits Rectangle {
    in property <image> icon-source;
    in property <color> tint: Theme.text-soft;
    in property <length> icon-size: 16px;
    in property <length> box-width: 18px;

    width: root.box-width;
    min-height: root.icon-size;
    background: transparent;
    Icon {
        source: root.icon-source;
        tint: root.tint;
        icon-size: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component PageHeading inherits Text {
    color: Theme.text;
    font-size: Theme.font-title;
    font-weight: 600;
    vertical-alignment: center;
}

export component PageSubtitle inherits Text {
    color: Theme.text-soft;
    font-size: 13px;
    vertical-alignment: center;
}

export component SectionHeading inherits Text {
    color: Theme.text-soft;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: bottom;
}

export component CaptionText inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-caption;
    overflow: elide;
}

export component SectionCard inherits Rectangle {
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    vertical-stretch: 0;
}

export component SettingsCard inherits Rectangle {
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    vertical-stretch: 0;

    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 0px;
        @children
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> tone: 0;
    in property <bool> interactive: false;
    callback clicked;

    property <color> badge-color: root.tone == 4 ? Theme.danger : (root.tone == 3 ? Theme.accent : (root.tone == 2 ? Theme.success : (root.tone == 1 ? Theme.primary-bright : Theme.text-soft)));
    property <color> badge-background: root.tone == 4 ? Theme.danger-soft : (root.tone == 3 ? Theme.accent-soft : (root.tone == 2 ? Theme.success-soft : (root.tone == 1 ? Theme.primary-soft : Theme.surface-raised)));

    height: 22px;
    border-radius: 11px;
    background: root.badge-background;
    border-width: badge-focus.has-focus ? 2px : 1px;
    border-color: badge-focus.has-focus ? Theme.focus : root.badge-color;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: badge-focus;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-action-default => { if root.interactive { root.clicked(); } }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;

        Text {
            text: root.text;
            color: root.badge-color;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    badge-touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => {
            badge-focus.focus();
            root.clicked();
        }
    }

    badge-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: root.interactive;

        key-pressed(event) => {
            if !root.interactive { return reject; }
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component HelpBadge inherits Rectangle {
    in property <string> description;
    in property <string> title: "Help";
    in property <length> popup-width: 296px;
    in property <length> popup-height: 132px;

    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: help-focus.has-focus ? 2px : 1px;
    border-color: help-focus.has-focus ? Theme.focus : (help-touch.has-hover ? Theme.primary-bright : Theme.border-bright);
    background: help-touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: help-focus;
    accessible-role: button;
    accessible-label: "Help: " + root.title;
    accessible-description: root.description;
    accessible-action-default => { help-popup.show(); }

    Text {
        text: "?";
        color: help-focus.has-focus ? Theme.focus : Theme.text-soft;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    help-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                help-popup.show();
                return accept;
            }
            return reject;
        }
    }

    help-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            help-focus.focus();
            help-popup.show();
        }
    }

    // Keep native hover text brief; detailed help is available to keyboard,
    // pointer and assistive-technology users through the wrapped popup below.
    if root.description != "": Tooltip { TooltipContent { text: "Click or press Enter for details."; } }

    help-popup := PopupWindow {
        x: 0px;
        y: root.height + 6px;
        width: root.popup-width;
        min-height: root.popup-height;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-bright;
            background: Theme.surface-raised;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: root.description;
                    color: Theme.text-soft;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <string> description: "";
    callback clicked;
    property <bool> hovered: button-touch.has-hover;

    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: button-focus.has-focus ? 2px : 1px;
    border-color: !root.enabled ? Theme.border : (button-focus.has-focus ? Theme.focus : (root.danger ? Theme.danger : (root.primary ? Theme.primary : Theme.border-bright)));
    background: !root.enabled ? transparent : (root.primary ? (root.hovered ? Theme.primary-bright : Theme.primary) : (root.danger ? (root.hovered ? Theme.danger-soft : transparent) : (root.hovered ? Theme.surface-hover : Theme.surface-raised)));
    forward-focus: button-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 6px;

        if root.has-icon: IconBox {
            icon-source: root.icon-source;
            tint: !root.enabled ? Theme.text-muted : (root.primary ? Theme.primary-text : (root.danger ? Theme.danger : Theme.text-soft));
            icon-size: 13px;
            box-width: 14px;
        }
        Text {
            horizontal-stretch: 0;
            text: root.text;
            color: !root.enabled ? Theme.text-muted : (root.primary ? Theme.primary-text : (root.danger ? Theme.danger : Theme.text));
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    button-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        // Slint 1.17 drops FocusOut when a scope is disabled. Keep the scope
        // active while gating navigation and activation with the control state.
        focus-on-tab-navigation: root.enabled;

        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    button-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            button-focus.focus();
            root.clicked();
        }
    }

    if root.description != "": Tooltip { TooltipContent { text: root.description; } }
}

export component SelectableButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> outlined: true;
    in property <bool> enabled: true;
    callback clicked;
    property <bool> hovered: select-touch.has-hover;

    height: 32px;
    min-width: 64px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: select-focus.has-focus ? 2px : (root.outlined ? 1px : 0px);
    border-color: select-focus.has-focus ? Theme.focus : (root.selected ? Theme.primary : (root.enabled ? Theme.border-bright : Theme.border));
    background: root.selected ? (root.outlined ? Theme.primary-soft : Theme.surface-raised) : (root.hovered ? Theme.surface-hover : (root.outlined ? Theme.surface-raised : transparent));
    forward-focus: select-focus;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Text {
        text: root.text;
        color: !root.enabled ? Theme.text-muted : (root.selected ? Theme.primary-bright : Theme.text-soft);
        font-size: 12.5px;
        font-weight: root.selected ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 9px;
        width: parent.width - 18px;
    }

    select-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: root.enabled;

        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    select-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            select-focus.focus();
            root.clicked();
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> description;
    in property <string> context: "";
    in property <bool> destructive: false;
    callback clicked;
    property <bool> hovered: icon-touch.has-hover;

    width: 32px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: root.hovered ? (root.destructive ? Theme.danger-soft : Theme.surface-raised) : transparent;
    border-width: icon-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    forward-focus: icon-focus;
    accessible-role: button;
    accessible-label: root.context == "" ? root.description : root.description + " for " + root.context;
    accessible-description: root.description;
    accessible-action-default => { root.clicked(); }

    Icon {
        source: root.icon-source;
        tint: root.destructive ? Theme.danger : (root.hovered ? Theme.primary-bright : Theme.text-soft);
        icon-size: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    icon-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    icon-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            icon-focus.focus();
            root.clicked();
        }
    }

    if root.description != "": Tooltip { TooltipContent { text: root.description; } }
}

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> selected: false;
    in property <bool> compact: false;
    callback clicked;
    property <bool> hovered: nav-touch.has-hover;

    height: 40px;
    vertical-stretch: 0;
    border-radius: 7px;
    background: root.selected ? Theme.primary-soft : (root.hovered ? Theme.surface-hover : transparent);
    border-width: nav-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    forward-focus: nav-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.selected ? "Current page" : "";
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: root.compact ? 0px : 11px;
        padding-right: root.compact ? 0px : 11px;
        spacing: 9px;
        alignment: root.compact ? center : start;

        IconBox {
            icon-source: root.icon-source;
            tint: root.selected ? Theme.primary-bright : Theme.text-soft;
            icon-size: 16px;
            box-width: 18px;
        }
        if !root.compact: Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-soft;
            font-size: 13.5px;
            font-weight: root.selected ? 600 : 450;
            vertical-alignment: center;
        }
    }

    nav-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    nav-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            nav-focus.focus();
            root.clicked();
        }
    }

    if root.compact: Tooltip { TooltipContent { text: root.text; } }
}

export component FieldLabel inherits Text {
    horizontal-alignment: left;
    color: Theme.text-soft;
    font-size: Theme.font-label;
    font-weight: 600;
    vertical-alignment: center;
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;

    width: 38px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.checked ? Theme.primary : Theme.border-bright;
    background: root.checked ? Theme.primary : Theme.surface-raised;
    opacity: root.enabled ? 1 : 0.5;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - self.y : self.y;
        background: root.checked ? Theme.primary-text : Theme.text-soft;
        animate x { duration: 120ms; }
    }
}

export component LabelBlock inherits VerticalLayout {
    cross-axis-alignment: stretch;
    horizontal-stretch: 1;
    in property <string> label;
    in property <string> description: "";
    in property <string> help: "";

    spacing: 3px;

    HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;
        width: 100%;
        FieldLabel { text: root.label; min-width: 0px; wrap: word-wrap; }
        HelpBadge {
            visible: root.help != "";
            description: root.help;
            title: root.label;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
    if root.description != "": Text {
        horizontal-alignment: left;
        text: root.description;
        color: Theme.text-muted;
        font-size: 12.5px;
        wrap: word-wrap;
    }
}

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <string> help: "";

    min-height: 56px;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 20px;
        cross-axis-alignment: center;

        LabelBlock {
            width: 42%;
            horizontal-stretch: 0;
            label: root.label;
            description: root.description;
            help: root.help;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            cross-axis-alignment: stretch;
            spacing: 6px;
            @children
        }
    }
}

export component SettingGroup inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <string> help: "";

    vertical-stretch: 0;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 10px;

        LabelBlock {
            label: root.label;
            description: root.description;
            help: root.help;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            @children
        }
    }
}

export component ToggleRow inherits Rectangle {
    in-out property <bool> checked;
    in property <string> title;
    in property <string> description: "";
    in property <string> help: "";
    in property <bool> enabled: true;
    callback toggled;
    property <bool> hovered: toggle-touch.has-hover;

    height: max(58px, toggle-labels.preferred-height + 24px);
    vertical-stretch: 0;
    border-radius: 6px;
    background: root.hovered && root.enabled ? Theme.surface-hover : transparent;
    border-width: toggle-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    forward-focus: toggle-focus;
    accessible-role: switch;
    accessible-label: root.title;
    accessible-description: root.description;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }

    toggle-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            toggle-focus.focus();
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 20px;
        cross-axis-alignment: center;

        toggle-labels := VerticalLayout {
            horizontal-stretch: 1;
            cross-axis-alignment: stretch;
            spacing: 3px;

            HorizontalLayout {
                spacing: 6px;
                cross-axis-alignment: center;
                width: 100%;
                Text {
                    height: self.preferred-height;
                    horizontal-alignment: left;
                    text: root.title;
                    color: root.enabled ? Theme.text : Theme.text-muted;
                    font-size: 13.5px;
                    font-weight: 600;
                    min-width: 0px;
                    wrap: word-wrap;
                }
                HelpBadge {
                    visible: root.help != "";
                    description: root.help;
                    title: root.title;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
            if root.description != "": Text {
                height: self.preferred-height;
                horizontal-alignment: left;
                text: root.description;
                color: Theme.text-muted;
                font-size: 12.5px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            width: 38px;
            alignment: center;

            Switch {
                checked: root.checked;
                enabled: root.enabled;
            }
        }
    }

    toggle-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: root.enabled;

        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == Key.Space || event.text == Key.Return {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

export component CompactField inherits Rectangle {
    in property <bool> field-enabled: true;
    in property <string> label: "";
    in property <string> hint: "";
    in property <bool> enabled: true;
    in property <string> font-family: "";
    in property <bool> font-italic: false;
    in property <length> font-size: Theme.font-label;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <InputType> input-type: InputType.text;
    in property <string> placeholder-text: "";
    in property <bool> read-only: false;
    in-out property <string> text <=> editor.text;
    out property <bool> has-focus: editor.has-focus;
    property <bool> suppress-proxy: false;
    callback accepted(string);
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    callback key-released(KeyEvent) -> EventResult;

    height: Theme.control-height;
    min-width: 160px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: editor;

    public function set-selection-offsets(start: int, end: int) { editor.set-selection-offsets(start, end); }
    public function select-all() { editor.select-all(); }
    public function clear-selection() { editor.clear-selection(); }
    public function cut() { editor.cut(); }
    public function copy() { editor.copy(); }
    public function paste() { editor.paste(); }

    key-pressed(event) => { return reject; }
    key-released(event) => { return reject; }

    // Native LineEdit's internal clip can hide offscreen fields from Slint's
    // tab traversal. This unclipped sibling reaches and reveals the editor.
    focus-proxy := FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: root.enabled && root.field-enabled && !root.suppress-proxy;
        focus-gained(reason) => {
            if root.enabled && root.field-enabled {
                editor.focus();
                editor.select-all();
            }
        }
    }

    // Reset eligibility after traversal; never defer focus or typed input.
    proxy-reset := Timer {
        interval: 1ms;
        running: false;
        triggered => { root.suppress-proxy = false; self.stop(); }
    }

    editor := LineEdit {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled && root.field-enabled;
        font-family: root.font-family;
        font-italic: root.font-italic;
        font-size: root.font-size;
        horizontal-alignment: root.horizontal-alignment;
        input-type: root.input-type;
        placeholder-text: root.placeholder-text;
        read-only: root.read-only;
        accessible-label: root.label;
        accessible-description: root.hint;
        accepted(value) => { root.accepted(value); }
        edited(value) => { root.edited(value); }
        key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                // Avoid revisiting this field's proxy when traversing back.
                root.suppress-proxy = true;
                proxy-reset.start();
                proxy-reset.restart();
            }
            root.key-pressed(event)
        }
        key-released(event) => { root.key-released(event) }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.control-radius;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.focus : (root.enabled && root.field-enabled ? Theme.border-bright : Theme.border);
        background: transparent;
    }
}

export component CompactSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> control-enabled: true;
    in property <string> label: "";
    in property <string> hint: "";
    in property <string> placeholder-text: "";
    property <bool> hovered: select-touch.has-hover;
    property <int> highlighted-index: 0;

    function open-choices() {
        if !root.control-enabled || root.model.length == 0 { return; }
        root.highlighted-index = clamp(root.current-index, 0, max(0, root.model.length - 1));
        choices.show();
    }

    function choose-option(index: int) {
        if !root.control-enabled || index < 0 || index >= root.model.length { return; }
        root.current-index = index;
        choices.close();
        select-focus.focus();
    }

    height: Theme.control-height;
    min-width: 150px;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: select-focus.has-focus || choices.is-open ? 2px : 1px;
    border-color: select-focus.has-focus || choices.is-open ? Theme.focus : (root.control-enabled ? Theme.border-bright : Theme.border);
    background: root.hovered ? Theme.surface-hover : Theme.surface-raised;
    forward-focus: select-focus;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-enabled: root.control-enabled;
    accessible-expandable: root.model.length > 0;
    accessible-expanded: choices.is-open;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : root.placeholder-text;
    accessible-action-expand => { if (root.control-enabled) { root.open-choices(); } }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : root.placeholder-text;
            color: root.control-enabled ? Theme.text : Theme.text-muted;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        IconBox {
            icon-source: Icons.chevron-down;
            tint: Theme.text-soft;
            icon-size: 10px;
            box-width: 12px;
        }
    }

    select-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: root.control-enabled;

        key-pressed(event) => {
            if !root.control-enabled { return reject; }
            if event.text == Key.DownArrow {
                root.current-index = clamp(root.current-index + 1, 0, max(0, root.model.length - 1));
                return accept;
            }
            if event.text == Key.UpArrow {
                root.current-index = clamp(root.current-index - 1, 0, max(0, root.model.length - 1));
                return accept;
            }
            if event.text == Key.Home {
                root.current-index = 0;
                return accept;
            }
            if event.text == Key.End {
                root.current-index = max(0, root.model.length - 1);
                return accept;
            }
            if event.text == Key.Space || event.text == Key.Return {
                root.open-choices();
                return accept;
            }
            return reject;
        }
    }

    select-touch := TouchArea {
        enabled: root.control-enabled;
        mouse-cursor: root.control-enabled ? pointer : default;
        clicked => {
            select-focus.focus();
            root.open-choices();
        }
    }

    choices := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.model.length * 32px + 8px;

        popup-focus := FocusScope {
            width: parent.width;
            height: parent.height;
            accessible-role: list;
            accessible-label: root.label + " options";
            accessible-enabled: root.control-enabled;
            accessible-orientation: Orientation.vertical;
            accessible-item-count: root.model.length;
            accessible-delegate-focus: root.highlighted-index;
            init => { self.focus(); }
            key-pressed(event) => {
                if !root.control-enabled {
                    choices.close();
                    select-focus.focus();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.highlighted-index = min(root.model.length - 1, root.highlighted-index + 1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.highlighted-index = max(0, root.highlighted-index - 1);
                    return accept;
                }
                if event.text == Key.Home { root.highlighted-index = 0; return accept; }
                if event.text == Key.End { root.highlighted-index = max(0, root.model.length - 1); return accept; }
                if event.text == Key.Return || event.text == Key.Space {
                    root.choose-option(root.highlighted-index);
                    return accept;
                }
                if event.text == Key.Escape {
                    choices.close();
                    select-focus.focus();
                    return accept;
                }
                if event.text == Key.Tab || event.text == Key.Backtab {
                    choices.close();
                    select-focus.focus();
                    return reject;
                }
                return reject;
            }

            Rectangle {
                background: Theme.surface-raised;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border-bright;

                VerticalLayout {
                    padding: 4px;

                    for option[index] in root.model: Rectangle {
                        height: 32px;
                        border-radius: 5px;
                        border-width: index == root.highlighted-index ? 2px : 0px;
                        border-color: Theme.focus;
                        background: index == root.current-index ? Theme.primary-soft : (index == root.highlighted-index || option-touch.has-hover ? Theme.surface-hover : transparent);
                        accessible-role: list-item;
                        accessible-label: option;
                        accessible-enabled: root.control-enabled;
                        accessible-item-selectable: true;
                        accessible-item-selected: index == root.current-index;
                        accessible-item-index: index;
                        accessible-action-default => { root.choose-option(index); }

                        Text {
                            text: option;
                            color: index == root.current-index ? Theme.primary-bright : Theme.text;
                            font-size: 13px;
                            font-weight: index == root.current-index ? 600 : 450;
                            vertical-alignment: center;
                            x: 10px;
                            width: parent.width - 20px;
                            overflow: elide;
                            accessible-role: none;
                        }
                        option-touch := TouchArea {
                            enabled: root.control-enabled;
                            mouse-cursor: pointer;
                            clicked => { root.choose-option(index); }
                        }
                    }
                }
            }
        }
    }
}

export component NumberStepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step-size: 1;
    in property <string> label: "";
    in property <string> hint: "";
    in property <bool> enabled: true;

    height: Theme.control-height;
    min-width: 112px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: number-input.has-focus ? 2px : 1px;
    border-color: number-input.has-focus ? Theme.focus : (root.enabled ? Theme.border-bright : Theme.border);
    background: Theme.surface-raised;
    forward-focus: number-input;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-description: root.hint + (root.hint == "" ? "" : " ") + "Type a number, or use the arrow keys to adjust it.";
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step-size;
    accessible-action-increment => { if root.enabled { root.value = min(root.maximum, root.value + root.step-size); } }
    accessible-action-decrement => { if root.enabled { root.value = max(root.minimum, root.value - root.step-size); } }
    accessible-action-set-value(value) => {
        if root.enabled && value.is-float() {
            root.value = round(clamp(value.to-float(), root.minimum, root.maximum));
        }
    }

    changed value => { number-input.text = root.value; }

    function commit-input() {
        if number-input.text.is-float() {
            root.value = round(clamp(number-input.text.to-float(), root.minimum, root.maximum));
        }
        number-input.text = root.value;
    }

    HorizontalLayout {
        minus := Rectangle {
            width: 28px;
            background: minus-touch.enabled && minus-touch.has-hover ? Theme.surface-hover : transparent;

            Text {
                text: "−";
                color: minus-touch.enabled ? Theme.text-soft : Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            minus-touch := TouchArea {
                enabled: root.enabled && root.value > root.minimum;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    number-input.focus();
                    root.commit-input();
                    root.value = max(root.minimum, root.value - root.step-size);
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        Rectangle {
            min-width: 54px;
            horizontal-stretch: 1;

            number-input := TextInput {
                width: parent.width;
                height: parent.height;
                text: "\{root.value}";
                enabled: root.enabled;
                input-type: InputType.number;
                single-line: true;
                color: root.enabled ? Theme.text : Theme.text-muted;
                selection-background-color: Theme.primary;
                selection-foreground-color: Theme.primary-text;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;

                edited => {
                    if self.text.is-float() {
                        root.value = round(clamp(self.text.to-float(), root.minimum, root.maximum));
                        if self.text.to-float() != root.value { self.text = root.value; }
                    }
                }
                accepted => { root.commit-input(); }
                changed has-focus => {
                    if !self.has-focus { root.commit-input(); }
                }
                key-pressed(event) => {
                    if event.text == Key.UpArrow {
                        root.commit-input();
                        root.value = min(root.maximum, root.value + root.step-size);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        root.commit-input();
                        root.value = max(root.minimum, root.value - root.step-size);
                        return accept;
                    }
                    if event.text == Key.PageUp {
                        root.commit-input();
                        root.value = min(root.maximum, root.value + root.step-size * 10);
                        return accept;
                    }
                    if event.text == Key.PageDown {
                        root.commit-input();
                        root.value = max(root.minimum, root.value - root.step-size * 10);
                        return accept;
                    }
                    if event.text == Key.Home {
                        root.value = root.minimum;
                        self.text = root.value;
                        return accept;
                    }
                    if event.text == Key.End {
                        root.value = root.maximum;
                        self.text = root.value;
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        plus := Rectangle {
            width: 28px;
            background: plus-touch.enabled && plus-touch.has-hover ? Theme.surface-hover : transparent;

            Text {
                text: "+";
                color: plus-touch.enabled ? Theme.text-soft : Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            plus-touch := TouchArea {
                enabled: root.enabled && root.value < root.maximum;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    number-input.focus();
                    root.commit-input();
                    root.value = min(root.maximum, root.value + root.step-size);
                }
            }
        }
    }
}

export component InlineNotice inherits Rectangle {
    in property <string> text;
    in property <string> detail: "";
    in property <string> action-text: "";
    in property <int> kind: 0;
    callback action();

    property <color> notice-color: root.kind == 2 ? Theme.danger : (root.kind == 1 ? Theme.primary-bright : Theme.accent);
    property <color> notice-background: root.kind == 2 ? Theme.danger-soft : (root.kind == 1 ? Theme.primary-soft : Theme.accent-soft);
    min-height: 44px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.notice-color;
    background: root.notice-background;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        cross-axis-alignment: center;

        IconBox {
            icon-source: root.kind == 1 ? Icons.update : Icons.warning;
            tint: root.notice-color;
            icon-size: 15px;
            box-width: 17px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.text;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.text-soft;
                font-size: 12.5px;
                wrap: word-wrap;
            }
        }
        if root.action-text != "": FlatButton {
            text: root.action-text;
            clicked => { root.action(); }
        }
    }
}

export component ChoiceCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    property <bool> hovered: choice-touch.has-hover;

    height: 76px;
    border-radius: 9px;
    border-width: choice-focus.has-focus ? 2px : 1px;
    border-color: choice-focus.has-focus ? Theme.focus : root.selected ? Theme.primary : Theme.border-bright;
    background: root.selected ? Theme.primary-soft : (root.hovered ? Theme.surface-hover : Theme.surface);
    forward-focus: choice-focus;
    accessible-role: radio-button;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 11px;
        cross-axis-alignment: stretch;

        VerticalLayout {
            width: 18px;
            alignment: center;

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.selected ? Theme.primary-bright : Theme.border-bright;
                background: root.selected ? Theme.primary : Theme.surface-raised;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.primary-text;
                    visible: root.selected;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            alignment: start;
            spacing: 3px;

            Text {
                text: root.title;
                color: root.enabled ? Theme.text : Theme.text-muted;
                font-size: 13.5px;
                font-weight: 600;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    choice-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: root.enabled;

        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    choice-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            choice-focus.focus();
            root.clicked();
        }
    }
}

export component StatusBar inherits Rectangle {
    in property <string> text: "Ready";
    in property <string> detail: "";
    in property <bool> busy: false;
    in property <bool> error: false;
    in property <bool> neutral: false;
    property <string> additional-detail: root.detail != root.text ? root.detail : "";

    height: Theme.status-height;
    background: Theme.sidebar;
    accessible-role: banner;
    accessible-live-region: polite;
    accessible-label: root.text + (root.additional-detail != "" ? ": " + root.additional-detail : "");

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        y: 1px;
        height: parent.height - 1px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 9px;
        cross-axis-alignment: center;

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.error ? Theme.danger : (root.busy ? Theme.accent : (root.neutral ? Theme.text-muted : Theme.success));
        }
        Text {
            text: root.text;
            color: root.error ? Theme.danger : Theme.text;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.additional-detail;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.additional-detail != "": Tooltip { TooltipContent { text: root.additional-detail; } }
}
